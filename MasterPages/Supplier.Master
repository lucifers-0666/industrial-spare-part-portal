<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Supplier.Master.cs" Inherits="IndustrialSparePartPortal.MasterPages.SupplierMaster" %>

<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-50">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - Supplier Operations Portal</title>
    <link href="~/Content/css/site.css" rel="stylesheet" type="text/css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body class="h-full flex flex-col font-['Inter',sans-serif] antialiased text-slate-900 bg-slate-50">
    <form id="form1" runat="server" class="flex flex-col min-h-full">
        <!-- Supplier Header -->
        <header class="bg-slate-900 text-white sticky top-0 z-40 border-b border-slate-800 shadow-md">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex justify-between items-center h-16">
                    <!-- Brand Logo -->
                    <div class="flex items-center gap-3">
                        <a href="~/Supplier/Dashboard.aspx" runat="server" class="flex items-center gap-2.5">
                            <div class="w-9 h-9 rounded-lg bg-emerald-600 flex items-center justify-center text-white font-bold text-sm shadow-sm">
                                <i class="fa-solid fa-warehouse"></i>
                            </div>
                            <div>
                                <span class="text-base font-bold tracking-tight text-white block leading-tight">SUPPLIER<span class="text-emerald-400">HUB</span></span>
                                <span class="text-[10px] text-slate-400 tracking-wider uppercase block">Industrial Inventory & Bidding</span>
                            </div>
                        </a>
                    </div>

                    <!-- Navigation Links -->
                    <nav class="hidden lg:flex items-center gap-6 text-sm font-medium">
                        <a href="~/Supplier/Dashboard.aspx" runat="server" class="text-slate-200 hover:text-emerald-400 transition-colors py-2">Dashboard</a>
                        <a href="~/Supplier/Inventory/ManageInventory.aspx" runat="server" class="text-slate-300 hover:text-emerald-400 transition-colors py-2">My Inventory</a>
                        <a href="~/Supplier/Quotations/RfqRequests.aspx" runat="server" class="text-slate-300 hover:text-emerald-400 transition-colors py-2">RFQ Requests & Bids</a>
                        <a href="~/Supplier/EmergencyRequests/EmergencyAlerts.aspx" runat="server" class="text-red-400 hover:text-red-300 transition-colors py-2 font-semibold">
                            <i class="fa-solid fa-bell animate-pulse text-xs"></i> Emergency Alerts
                        </a>
                        <a href="~/Supplier/Orders/SupplierOrders.aspx" runat="server" class="text-slate-300 hover:text-emerald-400 transition-colors py-2">Orders</a>
                    </nav>

                    <!-- Account Profile & Logout -->
                    <div class="flex items-center gap-4">
                        <div class="hidden sm:flex flex-col text-right">
                            <span class="text-xs font-semibold text-white" id="lblSupplierName" runat="server">Spare-Part Supplier</span>
                            <span class="text-[10px] text-emerald-400 font-medium" id="lblVerificationBadge" runat="server">
                                <i class="fa-solid fa-circle-check text-[8px]"></i> Verified Supplier
                            </span>
                        </div>
                        <div class="h-8 w-px bg-slate-800"></div>
                        <a href="~/Account/Logout.aspx" runat="server" class="text-xs font-medium text-slate-400 hover:text-red-400 transition-colors">
                            <i class="fa-solid fa-right-from-bracket"></i> Logout
                        </a>
                    </div>
                </div>
            </div>
        </header>

        <!-- Unverified Banner Notice if applicable -->
        <asp:PlaceHolder ID="phUnverifiedNotice" runat="server" Visible="false">
            <div class="bg-amber-500 text-slate-900 text-xs font-medium py-2 px-4 flex justify-between items-center border-b border-amber-600">
                <div class="flex items-center gap-2">
                    <i class="fa-solid fa-circle-exclamation text-sm"></i>
                    <span>Your Supplier Account is currently <strong>Pending Admin Verification</strong>. Please complete your company registration details to enable full RFQ bidding.</span>
                </div>
                <a href="~/Supplier/Profile/SupplierProfile.aspx" runat="server" class="bg-slate-900 text-white hover:bg-slate-800 font-semibold px-3 py-1 rounded text-xs transition-colors">
                    Upload Verification Docs
                </a>
            </div>
        </asp:PlaceHolder>

        <!-- Main Content -->
        <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>
        </main>

        <!-- Footer -->
        <footer class="bg-white border-t border-slate-200 py-6 text-xs text-slate-500 mt-auto">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row justify-between items-center gap-4">
                <p>© <%: DateTime.Now.Year %> Industrial Spare-Part Finder & Procurement Portal</p>
                <div class="flex items-center gap-4">
                    <a href="~/Supplier/Profile/SupplierProfile.aspx" runat="server" class="hover:text-emerald-600">Supplier Profile</a>
                    <a href="~/Supplier/Inventory/ManageInventory.aspx" runat="server" class="hover:text-emerald-600">Update Stock & Pricing</a>
                </div>
            </div>
        </footer>
    </form>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <asp:ContentPlaceHolder ID="ScriptsContent" runat="server">
    </asp:ContentPlaceHolder>
</body>
</html>

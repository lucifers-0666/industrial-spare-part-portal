<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="IndustrialSparePartPortal.MasterPages.SiteMaster" %>

<!DOCTYPE html>
<html lang="en" class="h-full bg-[#F8FAFC]">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - SPAREFINDER Industrial Procurement Network</title>
    
    <!-- Compiled Tailwind CSS & Industrial Design System -->
    <link href="<%= ResolveUrl("~/Content/css/site.css") %>?v=<%= DateTime.Now.Ticks %>" rel="stylesheet" type="text/css" />
    <link href="<%= ResolveUrl("~/Content/css/site-shell.css") %>?v=<%= DateTime.Now.Ticks %>" rel="stylesheet" type="text/css" />
    
    <!-- FontAwesome 6 Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    
    <!-- Google Fonts Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;600;700&display=swap" rel="stylesheet">

    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body class="h-full flex flex-col font-['Inter',sans-serif] antialiased text-[#0F172A] bg-[#F8FAFC]">
    <form id="form1" runat="server" class="flex flex-col min-h-full">

        <!-- ============================================================================ -->
        <!-- AUTHORITATIVE FIXED MASTER HEADER (.site-header)                             -->
        <!-- Robust fixed-to-viewport navigation with single maintained content offset    -->
        <!-- ============================================================================ -->
        <header id="headerWrapper" class="site-header" role="banner">
            <div class="site-header-inner">
                
                <!-- Brand Identity -->
                <a href="~/Default.aspx" runat="server" class="site-brand" aria-label="SPAREFINDER Home">
                    <div class="site-brand-icon">
                        <i class="fa-solid fa-gears text-sm"></i>
                    </div>
                    <div class="site-brand-text">
                        <span class="site-brand-title">SPARE<span>FINDER</span></span>
                        <span class="site-brand-sub">Procurement Network</span>
                    </div>
                </a>

                <!-- Desktop Primary Navigation -->
                <nav class="site-desktop-nav" aria-label="Main Navigation">
                    <a href="~/Default.aspx" runat="server" class="site-nav-link">Home</a>
                    <a href="~/Public/Parts.aspx" runat="server" class="site-nav-link">Spare Parts</a>
                    <a href="~/Public/Suppliers.aspx" runat="server" class="site-nav-link">Suppliers</a>
                    <a href="~/Public/Technicians.aspx" runat="server" class="site-nav-link">Technicians</a>
                    <a href="~/Public/HowItWorks.aspx" runat="server" class="site-nav-link">How It Works</a>
                    <a href="~/Public/WhyUs.aspx" runat="server" class="site-nav-link">Why Us</a>
                    <a href="~/Public/Emergency.aspx" runat="server" class="site-nav-link site-nav-link-emergency">
                        <i class="fa-solid fa-bolt text-xs"></i> Emergency Desk
                    </a>
                </nav>

                <!-- Action Controls & Emergency Telephone Direct Link -->
                <div class="site-header-actions">
                    <!-- Direct Emergency Support Link -->
                    <a href="tel:18000000000" class="site-header-phone hidden xl:inline-flex" title="24/7 Breakdown Sourcing Support">
                        <i class="fa-solid fa-phone text-[#EA580C]"></i> 1800-000-0000
                    </a>

                    <asp:PlaceHolder ID="phAnonymous" runat="server">
                        <a href="~/Account/Login.aspx" runat="server" class="site-btn-signin">
                            Sign In
                        </a>
                        <a href="~/Account/Register.aspx" runat="server" class="btn-primary text-xs py-2 px-3.5 font-bold shadow-xs">
                            <i class="fa-solid fa-user-plus text-xs"></i> Register
                        </a>
                    </asp:PlaceHolder>

                    <asp:PlaceHolder ID="phAuthenticated" runat="server" Visible="false">
                        <a id="lnkDashboard" runat="server" href="#" class="btn-secondary text-xs py-2 px-3 font-bold">
                            <i class="fa-solid fa-gauge-high text-xs"></i> Workspace
                        </a>
                        <a href="~/Account/Logout.aspx" runat="server" class="text-xs text-red-600 hover:text-red-700 font-bold px-2 py-1">Logout</a>
                    </asp:PlaceHolder>
                </div>

                <!-- Mobile Menu Hamburger Button (< 1024px) -->
                <button type="button" id="btnMobileToggle" class="site-mobile-toggle" aria-label="Toggle navigation menu" aria-expanded="false" aria-controls="mobileDrawer">
                    <i class="fa-solid fa-bars" id="iconMenu"></i>
                </button>

            </div>

            <!-- Mobile Navigation Drawer Overlay -->
            <div id="mobileDrawer" style="display: none;" class="site-mobile-menu" aria-label="Mobile Navigation">
                <nav class="flex flex-col space-y-1 text-sm font-semibold text-[#0F172A]">
                    <a href="~/Default.aspx" runat="server" class="px-3.5 py-2.5 rounded-lg hover:bg-slate-100 transition-colors">Home</a>
                    <a href="~/Public/Parts.aspx" runat="server" class="px-3.5 py-2.5 rounded-lg hover:bg-slate-100 transition-colors">Spare Parts Catalog</a>
                    <a href="~/Public/Suppliers.aspx" runat="server" class="px-3.5 py-2.5 rounded-lg hover:bg-slate-100 transition-colors">Supplier Directory</a>
                    <a href="~/Public/Technicians.aspx" runat="server" class="px-3.5 py-2.5 rounded-lg hover:bg-slate-100 transition-colors">Field Technicians</a>
                    <a href="~/Public/HowItWorks.aspx" runat="server" class="px-3.5 py-2.5 rounded-lg hover:bg-slate-100 transition-colors">How It Works</a>
                    <a href="~/Public/WhyUs.aspx" runat="server" class="px-3.5 py-2.5 rounded-lg hover:bg-slate-100 transition-colors">Platform Comparison</a>
                    <a href="~/Public/Emergency.aspx" runat="server" class="px-3.5 py-2.5 rounded-lg bg-orange-50 text-[#EA580C] font-bold border border-orange-200 mt-1">
                        <i class="fa-solid fa-bolt mr-2"></i> Emergency Breakdown Desk
                    </a>
                </nav>

                <div class="pt-4 mt-4 border-t border-[#CBD5E1] flex flex-col gap-2.5">
                    <a href="tel:18000000000" class="text-xs font-mono font-bold text-[#475569] flex items-center justify-center gap-2 py-2 bg-slate-100 rounded-lg">
                        <i class="fa-solid fa-phone text-[#EA580C]"></i> Hotline: 1800-000-0000
                    </a>
                    <a href="~/Account/Login.aspx" runat="server" class="btn-secondary w-full justify-center text-xs py-2.5 font-bold">Sign In to Account</a>
                    <a href="~/Account/Register.aspx" runat="server" class="btn-primary w-full justify-center text-xs py-2.5 font-bold">Register Portal Account</a>
                </div>
            </div>
        </header>

        <!-- Mobile Drawer Backdrop Overlay -->
        <div id="mobileDrawerBackdrop" class="site-mobile-backdrop" style="display: none;"></div>

        <!-- ============================================================================ -->
        <!-- MAIN CONTENT AREA                                                            -->
        <!-- ============================================================================ -->
        <main class="flex-1" role="main">
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>
        </main>

        <!-- ============================================================================ -->
        <!-- CONCISE PRE-FOOTER EMERGENCY DESK CALLOUT                                    -->
        <!-- ============================================================================ -->
        <section class="bg-gradient-to-r from-orange-50 via-white to-amber-50 border-t border-b border-[#CBD5E1] py-10 px-4 sm:px-6 lg:px-8">
            <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
                <div class="space-y-1.5 max-w-2xl">
                    <div class="flex items-center gap-2">
                        <span class="spec-tag spec-tag-orange"><i class="fa-solid fa-bolt"></i> EMERGENCY PROTOCOL</span>
                        <span class="text-xs text-[#64748B] font-mono">CRITICAL DOWNTIME SOURCING</span>
                    </div>
                    <h3 class="text-xl font-bold text-[#0F172A] m-0">Critical machine stopped on your plant floor?</h3>
                    <p class="text-xs sm:text-sm text-[#475569] m-0 leading-relaxed">
                        Broadcast urgent OEM part requirements or model specifications to nearby verified stockists and on-call field engineers.
                    </p>
                </div>
                <div class="flex items-center gap-3 shrink-0">
                    <a href="tel:18000000000" class="btn-secondary text-xs py-2.5 px-4 font-mono font-bold hidden sm:inline-flex">
                        <i class="fa-solid fa-phone text-[#EA580C]"></i> 1800-000-0000
                    </a>
                    <a href="~/Public/Emergency.aspx" runat="server" class="btn-emergency text-xs py-2.5 px-5 font-bold shadow-xs whitespace-nowrap">
                        <i class="fa-solid fa-triangle-exclamation mr-1.5"></i> Submit Breakdown Alert
                    </a>
                </div>
            </div>
        </section>

        <!-- ============================================================================ -->
        <!-- CONTROLLED DARK INDUSTRIAL FOOTER (#0F172A)                                  -->
        <!-- ============================================================================ -->
        <footer id="siteFooter" class="site-footer" role="contentinfo">
            <div class="site-footer-inner">
                
                <div class="site-footer-grid">
                    
                    <!-- Brand Column -->
                    <div class="space-y-4">
                        <div class="flex items-center gap-2.5">
                            <div class="w-8 h-8 rounded-lg bg-[#1E293B] border border-slate-700 flex items-center justify-center text-white">
                                <i class="fa-solid fa-gears text-sm text-[#38BDF8]"></i>
                            </div>
                            <div>
                                <span class="text-lg font-black tracking-tight text-white leading-none block">SPARE<span class="text-[#38BDF8]">FINDER</span></span>
                                <span class="text-[9px] font-bold text-[#64748B] tracking-wider uppercase block mt-0.5 font-mono">B2B Industrial Network</span>
                            </div>
                        </div>
                        <p class="text-xs text-[#94A3B8] leading-relaxed max-w-sm m-0">
                            Digital spare-part discovery, multi-supplier quotation comparison, emergency breakdown sourcing, and certified technical field assistance in one unified platform.
                        </p>
                        <div>
                            <span class="spec-tag spec-tag-amber text-[10px]">MCA FINAL ACADEMIC PROJECT</span>
                        </div>
                    </div>

                    <!-- Column 1: DIRECTORIES -->
                    <div>
                        <h4 class="site-footer-heading">
                            <span class="w-1.5 h-1.5 rounded-full bg-[#38BDF8]"></span> DIRECTORIES
                        </h4>
                        <ul class="site-footer-links">
                            <li><a href="~/Public/Parts.aspx" runat="server">Spare-Part Catalog</a></li>
                            <li><a href="~/Public/Suppliers.aspx" runat="server">Verified Suppliers</a></li>
                            <li><a href="~/Public/Technicians.aspx" runat="server">Field Service Engineers</a></li>
                            <li><a href="~/Public/Emergency.aspx" runat="server">Emergency Breakdown Desk</a></li>
                        </ul>
                    </div>

                    <!-- Column 2: ARCHITECTURE -->
                    <div>
                        <h4 class="site-footer-heading">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> ARCHITECTURE
                        </h4>
                        <ul class="site-footer-links">
                            <li><a href="~/Public/HowItWorks.aspx" runat="server">8-Step Procurement Flow</a></li>
                            <li><a href="~/Public/WhyUs.aspx" runat="server">Platform vs Traditional</a></li>
                            <li><a href="~/Public/WhyUs.aspx#verification" runat="server">Governance & Audit</a></li>
                            <li><a href="~/Public/HowItWorks.aspx#protocol" runat="server">Breakdown Protocol</a></li>
                        </ul>
                    </div>

                    <!-- Column 3: WORKSPACE -->
                    <div>
                        <h4 class="site-footer-heading">
                            <span class="w-1.5 h-1.5 rounded-full bg-[#EA580C]"></span> WORKSPACE
                        </h4>
                        <ul class="site-footer-links">
                            <li><a href="~/Account/Login.aspx" runat="server">Portal Sign In</a></li>
                            <li><a href="~/Account/Register.aspx" runat="server">Register Entity Account</a></li>
                            <li><a href="~/Account/Login.aspx" runat="server">Factory Buyer Console</a></li>
                            <li><a href="tel:18000000000">Support Desk (1800-000-0000)</a></li>
                        </ul>
                    </div>

                </div>

                <!-- Footer Bottom Disclaimer & Copyright -->
                <div class="site-footer-bottom">
                    <div>
                        <span>&copy; <%: DateTime.Now.Year %> SPAREFINDER Industrial Procurement Network &middot; Master of Computer Applications (MCA) Project</span>
                    </div>
                    <div class="flex items-center gap-4 text-xs">
                        <span class="text-slate-500">ASP.NET Web Forms &middot; SQL Server &middot; ADO.NET</span>
                    </div>
                </div>

            </div>
        </footer>
    </form>

    <!-- Public Shell JavaScript -->
    <script src="<%= ResolveUrl("~/Content/js/site-shell.js") %>?v=<%= DateTime.Now.Ticks %>"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <asp:ContentPlaceHolder ID="ScriptsContent" runat="server">
    </asp:ContentPlaceHolder>
</body>
</html>

<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="IndustrialSparePartPortal.MasterPages.SiteMaster" %>

<!DOCTYPE html>
<html lang="en" class="h-full bg-[#F8FAFC] scroll-smooth">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - Industrial Spare-Part Finder & Emergency Procurement Portal</title>
    
    <!-- Compiled Tailwind CSS & Industrial Design System (With Dynamic Cache-Buster) -->
    <link href="<%= ResolveUrl("~/Content/css/site.css") %>?v=<%= DateTime.Now.Ticks %>" rel="stylesheet" type="text/css" />
    <link href="<%= ResolveUrl("~/Content/css/site-shell.css") %>?v=<%= DateTime.Now.Ticks %>" rel="stylesheet" type="text/css" />
    <link href="<%= ResolveUrl("~/Content/css/public-pages.css") %>?v=<%= DateTime.Now.Ticks %>" rel="stylesheet" type="text/css" />
    
    <!-- FontAwesome 6 Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    
    <!-- Google Fonts Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body class="h-full flex flex-col font-['Inter',sans-serif] antialiased text-[#172033] bg-[#F8FAFC] selection:bg-[#1677FF] selection:text-white">
    <form id="form1" runat="server" class="flex flex-col min-h-full">

        <!-- ============================================================================ -->
        <!-- 1. TOP UTILITY STRIP                                                         -->
        <!-- ============================================================================ -->
        <div class="site-top-strip">
            <div class="site-top-strip-inner">
                <div class="flex items-center gap-2.5">
                    <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded bg-[#F97316] text-white font-extrabold text-[10px] uppercase tracking-wider">
                        <i class="fa-solid fa-triangle-exclamation animate-pulse"></i> EMERGENCY DESK
                    </span>
                    <span class="text-[#526174] font-medium hidden md:inline text-xs">
                        Connecting Industrial Plants, Suppliers & Technical Support
                    </span>
                </div>
                <div class="flex items-center gap-3">
                    <a href="tel:18000000000" class="hover:text-[#1677FF] font-mono font-bold text-xs flex items-center gap-1.5 text-[#172033]">
                        <i class="fa-solid fa-phone text-[#F97316]"></i> Demo Support: 1800-000-0000
                    </a>
                </div>
            </div>
        </div>

        <!-- ============================================================================ -->
        <!-- 2. STICKY SOLID MASTER HEADER (.site-header)                                 -->
        <!-- ============================================================================ -->
        <header id="headerWrapper" class="site-header">
            <div class="site-header-inner">
                
                <!-- Left: Compact Brand Logo -->
                <a href="~/Default.aspx" runat="server" class="site-brand">
                    <div class="site-brand-icon">
                        <i class="fa-solid fa-gears"></i>
                    </div>
                    <div class="site-brand-text">
                        <span class="site-brand-title">SPARE<span>FINDER</span></span>
                        <span class="site-brand-sub">Procurement Network</span>
                    </div>
                </a>

                <!-- Center: Desktop Navigation Links (Single-Row, Never Wraps) -->
                <nav class="site-desktop-nav">
                    <a href="~/Default.aspx" runat="server" class="site-nav-link active">Home</a>
                    <a href="~/Public/HowItWorks.aspx" runat="server" class="site-nav-link">How It Works</a>
                    <a href="~/Public/WhyUs.aspx" runat="server" class="site-nav-link">Why Us</a>
                    <a href="~/Public/Parts.aspx" runat="server" class="site-nav-link">Spare Parts</a>
                    <a href="~/Public/Suppliers.aspx" runat="server" class="site-nav-link">Suppliers</a>
                    <a href="~/Public/Technicians.aspx" runat="server" class="site-nav-link">Technicians</a>
                    <a href="~/Public/Emergency.aspx" runat="server" class="site-nav-link site-nav-link-emergency">
                        <i class="fa-solid fa-bolt text-xs"></i> Emergency
                    </a>
                </nav>

                <!-- Right: Desktop Authentication Actions -->
                <div class="site-header-actions">
                    <asp:PlaceHolder ID="phAnonymous" runat="server">
                        <a href="~/Account/Login.aspx" runat="server" class="site-btn-signin">
                            Sign In
                        </a>
                        <a href="~/Account/Register.aspx" runat="server" class="btn-primary text-xs py-2 px-3.5 font-extrabold shadow-xs">
                            <i class="fa-solid fa-user-plus text-xs"></i> Register Portal
                        </a>
                    </asp:PlaceHolder>
                    <asp:PlaceHolder ID="phAuthenticated" runat="server" Visible="false">
                        <a id="lnkDashboard" runat="server" href="#" class="btn-secondary text-xs py-2 px-3 font-bold">
                            <i class="fa-solid fa-gauge-high"></i> Dashboard
                        </a>
                        <a href="~/Account/Logout.aspx" runat="server" class="text-xs text-red-600 hover:text-red-700 font-bold px-2 py-1">Logout</a>
                    </asp:PlaceHolder>
                </div>

                <!-- Mobile Menu Hamburger Button (Hidden on Desktop >= 1024px) -->
                <button type="button" id="btnMobileToggle" class="site-mobile-toggle" aria-label="Toggle Navigation">
                    <i class="fa-solid fa-bars" id="iconMenu"></i>
                </button>

            </div>

            <!-- Mobile Drawer Overlay (Positioned Absolutely Below Header, Initially Hidden) -->
            <div id="mobileDrawer" style="display: none;" class="site-mobile-menu">
                <nav class="flex flex-col space-y-1.5 text-sm font-semibold text-[#172033]">
                    <a href="~/Default.aspx" runat="server" class="px-3.5 py-2 rounded-xl bg-blue-50 text-[#1677FF] font-bold">Home</a>
                    <a href="~/Public/HowItWorks.aspx" runat="server" class="px-3.5 py-2 rounded-xl hover:bg-slate-100">How It Works</a>
                    <a href="~/Public/WhyUs.aspx" runat="server" class="px-3.5 py-2 rounded-xl hover:bg-slate-100">Why Us</a>
                    <a href="~/Public/Parts.aspx" runat="server" class="px-3.5 py-2 rounded-xl hover:bg-slate-100">Spare Parts</a>
                    <a href="~/Public/Suppliers.aspx" runat="server" class="px-3.5 py-2 rounded-xl hover:bg-slate-100">Suppliers</a>
                    <a href="~/Public/Technicians.aspx" runat="server" class="px-3.5 py-2 rounded-xl hover:bg-slate-100">Technicians</a>
                    <a href="~/Public/Emergency.aspx" runat="server" class="px-3.5 py-2 rounded-xl bg-orange-50 text-[#F97316] font-extrabold border border-orange-200">
                        <i class="fa-solid fa-bolt mr-2"></i> Emergency Procurement
                    </a>
                </nav>
                <div class="pt-3.5 mt-3 border-t border-[#D9E1EA] flex flex-col gap-2">
                    <a href="~/Account/Login.aspx" runat="server" class="btn-secondary w-full justify-center text-xs py-2.5 font-bold">Sign In</a>
                    <a href="~/Account/Register.aspx" runat="server" class="btn-primary w-full justify-center text-xs py-2.5 font-extrabold">Register Portal Account</a>
                </div>
            </div>
        </header>

        <!-- ============================================================================ -->
        <!-- 3. MAIN BODY CONTENT PLACEHOLDER                                             -->
        <!-- ============================================================================ -->
        <main class="flex-1">
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>
        </main>

        <!-- ============================================================================ -->
        <!-- 4. INDEPENDENT BALANCED EMERGENCY CTA CARD (ABOVE FOOTER)                    -->
        <!-- ============================================================================ -->
        <section class="emergency-cta-section">
            <div class="emergency-cta-card">
                <div class="emergency-cta-content">
                    <h3 class="emergency-cta-title">
                        <i class="fa-solid fa-bolt text-[#F97316]"></i> Need an urgent industrial spare part?
                    </h3>
                    <p class="emergency-cta-desc">
                        Submit a breakdown request and share your part number, machine model or requirement to alert nearby verified suppliers and field service technicians.
                    </p>
                </div>
                <div class="emergency-cta-actions">
                    <a href="tel:18000000000" class="text-xs font-mono font-bold text-[#526174] hover:text-[#1677FF] hidden md:inline-flex items-center gap-1.5">
                        <i class="fa-solid fa-phone text-[#F97316]"></i> 1800-000-0000
                    </a>
                    <a href="~/Public/Emergency.aspx" runat="server" class="btn-emergency text-xs py-2.5 px-6 font-extrabold whitespace-nowrap shadow-xs">
                        <i class="fa-solid fa-bolt mr-1.5"></i> Start Emergency Request
                    </a>
                </div>
            </div>
        </section>

        <!-- ============================================================================ -->
        <!-- 5. CONTROLLED DARK INDUSTRIAL B2B FOOTER (#0F172A DEEP SLATE/NAVY)           -->
        <!-- ============================================================================ -->
        <footer id="siteFooter" class="site-footer">
            <div class="site-footer-inner">
                
                <!-- Main 4-Column Grid -->
                <div class="site-footer-grid">
                    
                    <!-- Brand Column -->
                    <div class="site-footer-brand">
                        <div class="flex items-center gap-2.5">
                            <div class="w-9 h-9 rounded-xl bg-[#1677FF] flex items-center justify-center text-white shadow-xs">
                                <i class="fa-solid fa-gears text-base text-white"></i>
                            </div>
                            <div>
                                <span class="text-xl font-black tracking-tight text-white leading-none block">SPARE<span class="text-[#38BDF8]">FINDER</span></span>
                                <span class="text-[10px] font-bold text-[#64748B] tracking-wider uppercase block mt-0.5">Industrial Procurement Network</span>
                            </div>
                        </div>
                        <p class="text-xs text-[#94A3B8] leading-relaxed max-w-sm m-0">
                            Industrial spare-part discovery, supplier comparison, quotation requests and technical support in one connected platform.
                        </p>
                        <div class="pt-1">
                            <span class="copper-tag bg-amber-500/10 text-amber-400 border border-amber-500/30">B2B INDUSTRIAL NETWORK</span>
                        </div>
                    </div>

                    <!-- Column 1: EXPLORE -->
                    <div>
                        <h4 class="site-footer-heading">
                            <span class="w-2 h-2 rounded-full bg-[#1677FF]"></span> EXPLORE
                        </h4>
                        <ul class="site-footer-links">
                            <li><a href="~/Public/Parts.aspx" runat="server">Spare Parts</a></li>
                            <li><a href="~/Public/Suppliers.aspx" runat="server">Suppliers</a></li>
                            <li><a href="~/Public/Technicians.aspx" runat="server">Technicians</a></li>
                            <li><a href="~/Public/HowItWorks.aspx" runat="server">How It Works</a></li>
                        </ul>
                    </div>

                    <!-- Column 2: PROCUREMENT -->
                    <div>
                        <h4 class="site-footer-heading">
                            <span class="w-2 h-2 rounded-full bg-emerald-400"></span> PROCUREMENT
                        </h4>
                        <ul class="site-footer-links">
                            <li><a href="~/Public/Parts.aspx" runat="server">Part Discovery</a></li>
                            <li><a href="~/Public/Suppliers.aspx" runat="server">Compare Suppliers</a></li>
                            <li><a href="~/Public/Parts.aspx" runat="server">Quotation Requests</a></li>
                            <li><a href="~/Public/Emergency.aspx" runat="server">Emergency Requests</a></li>
                        </ul>
                    </div>

                    <!-- Column 3: PORTAL -->
                    <div>
                        <h4 class="site-footer-heading">
                            <span class="w-2 h-2 rounded-full bg-[#F97316]"></span> PORTAL
                        </h4>
                        <ul class="site-footer-links">
                            <li><a href="~/Account/Login.aspx" runat="server">Sign In</a></li>
                            <li><a href="~/Account/Register.aspx" runat="server">Register</a></li>
                            <li><a href="~/Public/WhyUs.aspx" runat="server">Why Us</a></li>
                            <li><a href="tel:18000000000">Support</a></li>
                        </ul>
                    </div>

                </div>

                <!-- Footer Bottom Copyright Bar -->
                <div class="site-footer-bottom">
                    <div>
                        <span>&copy; <%: DateTime.Now.Year %> SPAREFINDER Industrial Procurement Network &middot; Demonstration / Academic Project</span>
                    </div>
                    <div class="flex items-center gap-4 font-medium text-xs">
                        <a href="~/Public/WhyUs.aspx" runat="server" class="hover:text-white transition-colors">Platform Information</a>
                        <span class="text-slate-600">&middot;</span>
                        <a href="~/Public/HowItWorks.aspx" runat="server" class="hover:text-white transition-colors">How It Works</a>
                        <span class="text-slate-600">&middot;</span>
                        <a href="~/Account/Login.aspx" runat="server" class="hover:text-white transition-colors">Portal Login</a>
                    </div>
                </div>

            </div>
        </footer>
    </form>

    <!-- Public Shell JavaScript (With Dynamic Cache-Buster) -->
    <script src="<%= ResolveUrl("~/Content/js/site-shell.js") %>?v=<%= DateTime.Now.Ticks %>"></script>

    <!-- SweetAlert2 Script -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <asp:ContentPlaceHolder ID="ScriptsContent" runat="server">
    </asp:ContentPlaceHolder>
</body>
</html>

<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="IndustrialSparePartPortal.MasterPages.SiteMaster" %>

<!DOCTYPE html>
<html lang="en" class="h-full bg-[#F8FAFC]">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#ffffff" />
    <title><%: Page.Title %> - Industrial Spare-Part Finder & Emergency Procurement Portal</title>
    <link href="~/Content/css/site.css" rel="stylesheet" type="text/css" />
    <link href="~/Content/css/site-shell.css" rel="stylesheet" type="text/css" />
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>
</head>
<body class="h-full font-['Inter',sans-serif] antialiased">
    <form id="form1" runat="server">
        <div id="headerWrapper" class="site-header">
            <div class="site-utility">
                <div class="site-container site-utility-inner">
                    <div class="site-utility-message">
                        <span class="site-utility-badge"><i class="fa-solid fa-bolt"></i> Emergency Procurement</span>
                        <span class="site-utility-divider">|</span>
                        <span class="site-utility-text">Industrial spare-part discovery, supplier comparison & technical support</span>
                    </div>
                    <span class="site-demo-contact">Demo Contact: <strong>1800-000-0000</strong></span>
                </div>
            </div>
            <header id="mainHeader" class="site-navbar">
                <div class="site-container site-navbar-inner">
                    <a href="~/Default.aspx" runat="server" class="site-brand" aria-label="SPAREFINDER home">
                        <span class="site-brand-mark"><i class="fa-solid fa-gears"></i></span>
                        <span class="site-brand-copy">
                            <span class="site-brand-name">SPARE<span>FINDER</span></span>
                            <span class="site-brand-subtitle">Industrial Procurement Network</span>
                        </span>
                    </a>
                    <nav class="site-desktop-nav" aria-label="Primary navigation">
                        <a class="site-nav-link is-active" href="~/Default.aspx" runat="server">Home</a>
                        <a class="site-nav-link" href="#how-it-works">How It Works</a>
                        <a class="site-nav-link" href="#differentiators">Why Us</a>
                        <a class="site-nav-link" href="#parts-catalog">Spare Parts</a>
                        <a class="site-nav-link" href="#supplier-comparison">Suppliers</a>
                        <a class="site-nav-link" href="#technicians">Technicians</a>
                        <a class="site-nav-link site-nav-link-emergency" href="#emergency"><i class="fa-solid fa-bolt"></i> Emergency</a>
                    </nav>
                    <div class="site-nav-actions">
                        <asp:PlaceHolder ID="phAnonymous" runat="server">
                            <a href="~/Account/Login.aspx" runat="server" class="site-signin">Sign In</a>
                            <a href="~/Account/Register.aspx" runat="server" class="site-register"><i class="fa-solid fa-user-plus"></i> Register</a>
                        </asp:PlaceHolder>
                        <asp:PlaceHolder ID="phAuthenticated" runat="server" Visible="false">
                            <a id="lnkDashboard" runat="server" href="#" class="site-register"><i class="fa-solid fa-gauge-high"></i> Dashboard</a>
                            <a href="~/Account/Logout.aspx" runat="server" class="site-signin site-signout">Logout</a>
                        </asp:PlaceHolder>
                    </div>
                    <button type="button" id="btnMobileToggle" class="site-mobile-toggle" aria-label="Open navigation" aria-controls="mobileDrawer" aria-expanded="false">
                        <i class="fa-solid fa-bars" id="iconMenu"></i>
                    </button>
                </div>
                <div id="mobileDrawer" class="site-mobile-drawer" aria-hidden="true">
                    <nav class="site-mobile-nav" aria-label="Mobile navigation">
                        <a href="~/Default.aspx" runat="server" class="is-active">Home</a>
                        <a href="#how-it-works">How It Works</a>
                        <a href="#differentiators">Why Us</a>
                        <a href="#parts-catalog">Spare Parts</a>
                        <a href="#supplier-comparison">Suppliers</a>
                        <a href="#technicians">Technicians</a>
                        <a href="#emergency" class="is-emergency"><i class="fa-solid fa-bolt"></i> Emergency Procurement</a>
                    </nav>
                    <div class="site-mobile-actions">
                        <a href="~/Account/Login.aspx" runat="server" class="site-mobile-secondary">Sign In</a>
                        <a href="~/Account/Register.aspx" runat="server" class="site-mobile-primary">Register Portal</a>
                    </div>
                </div>
            </header>
        </div>
        <main class="site-main">
            <asp:ContentPlaceHolder ID="MainContent" runat="server"></asp:ContentPlaceHolder>
        </main>
        <footer class="site-footer">
            <div class="site-container">
                <section class="site-footer-cta" aria-label="Emergency procurement call to action">
                    <div>
                        <span class="site-footer-kicker"><i class="fa-solid fa-bolt"></i> URGENT PROCUREMENT</span>
                        <h2>Need an industrial spare part?</h2>
                        <p>Start a demo emergency request and explore the sourcing workflow.</p>
                    </div>
                    <a href="#emergency" class="site-footer-cta-button">Start Emergency Request <i class="fa-solid fa-arrow-right"></i></a>
                </section>
                <div class="site-footer-grid">
                    <div class="site-footer-brand">
                        <div class="site-footer-brand-row">
                            <span class="site-brand-mark site-footer-brand-mark"><i class="fa-solid fa-gears"></i></span>
                            <div>
                                <div class="site-footer-brand-name">SPARE<span>FINDER</span></div>
                                <div class="site-footer-brand-subtitle">Industrial Procurement Network</div>
                            </div>
                        </div>
                        <p>A project platform concept for industrial spare-part discovery, supplier comparison, quotation requests, emergency sourcing and technician discovery.</p>
                        <span class="site-footer-demo-label">Demonstration website — sample data only</span>
                    </div>
                    <div class="site-footer-column">
                        <h3>Platform</h3>
                        <a href="#parts-catalog">Spare Parts</a>
                        <a href="#supplier-comparison">Supplier Comparison</a>
                        <a href="#how-it-works">How It Works</a>
                        <a href="#differentiators">Why Us</a>
                        <a href="#technicians">Technicians</a>
                    </div>
                    <div class="site-footer-column">
                        <h3>Procurement</h3>
                        <a href="#parts-catalog">Part Discovery</a>
                        <a href="#supplier-comparison">RFQ / Quotations</a>
                        <a href="#emergency">Emergency Requests</a>
                        <a href="#emergency">Request Tracking</a>
                        <a href="#differentiators">Service History</a>
                    </div>
                    <div class="site-footer-column">
                        <h3>Account</h3>
                        <a href="~/Account/Login.aspx" runat="server">Sign In</a>
                        <a href="~/Account/Register.aspx" runat="server">Register</a>
                        <a href="#technicians">Technical Support</a>
                        <a href="#contact">Contact</a>
                    </div>
                </div>
                <div class="site-footer-bottom">
                    <span>© 2026 SPAREFINDER Industrial Procurement Network. Project demonstration.</span>
                    <div><a href="#privacy">Privacy</a><a href="#terms">Terms</a><a href="#contact">Contact</a></div>
                </div>
            </div>
        </footer>
        <asp:ContentPlaceHolder ID="ScriptsContent" runat="server"></asp:ContentPlaceHolder>
    </form>
    <script src="<%= ResolveUrl("~/Content/js/site-shell.js") %>"></script>
</body>
</html>
